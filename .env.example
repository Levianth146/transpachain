# Copy to .env on EC2 (~/transpachain/.env) and fill in values
# See each submodule's .env.example for details

ALCHEMY_SEPOLIA_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
PINATA_API_KEY=
PINATA_SECRET_KEY=
MONGODB_URI=mongodb://localhost:27017/transpachain
CORS_ORIGIN=https://transpachain.site
# Block when contracts were deployed (Etherscan). Omit or 0 to skip backfill.
# Alchemy free tier: keep range small OR set INDEXER_LOG_CHUNK_SIZE=10 (default).
DEPLOY_FROM_BLOCK=11046235
INDEXER_LOG_CHUNK_SIZE=10

# Backend indexer + API
CHARITY_CORE_ADDRESS=0xA13344e56a2421322bb2985ffE37b07DB80B760d
DONATION_VAULT_ADDRESS=0x72116A0BCe20473FE1BfcC2da9D2337A6D39Ed5c
GOVERNANCE_DAO_ADDRESS=0x290770c85B42c3a32365f6f6350587878dCbe2D5
IMPACT_NFT_ADDRESS=0x17CcdcF683626B5c914640154464bF64Ca66DB18

# Frontend — required at `docker compose build frontend` (baked into client JS)
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_CHARITY_CORE_ADDRESS=0xA13344e56a2421322bb2985ffE37b07DB80B760d
NEXT_PUBLIC_DONATION_VAULT_ADDRESS=0x72116A0BCe20473FE1BfcC2da9D2337A6D39Ed5c
NEXT_PUBLIC_GOVERNANCE_DAO_ADDRESS=0x290770c85B42c3a32365f6f6350587878dCbe2D5
NEXT_PUBLIC_IMPACT_NFT_ADDRESS=0x17CcdcF683626B5c914640154464bF64Ca66DB18
